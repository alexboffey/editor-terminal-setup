#!/usr/bin/env bash
# dev — launch tmux with nvim/terminal/claude layout
SESSION="dev"

# Attach if already running
if tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux attach-session -t "$SESSION"
  exit 0
fi

tmux new-session -d -s "$SESSION" -c "$PWD"

# Split right column for claude (25% width)
tmux split-window -h -p 25 -t "$SESSION"

# Split left pane: bottom 30% for terminal
tmux split-window -v -p 25 -t "$SESSION:0.0"

# Split bottom terminal into two side by side
tmux split-window -h -p 50 -t "$SESSION:0.1"

# Run commands
tmux send-keys -t "$SESSION:0.0" "nvim" Enter
tmux send-keys -t "$SESSION:0.3" "claude" Enter
# panes 0.1 and 0.2 are plain terminals

# Focus nvim pane
tmux select-pane -t "$SESSION:0.0"

tmux attach-session -t "$SESSION"
